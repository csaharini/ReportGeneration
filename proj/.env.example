# Read-only MySQL connection used by /api/project-by-rae/{rae_id}
# Keep the real values in your hosting environment; do not commit a real .env file.
RAE_DB_HOST=your-db-host
RAE_DB_PORT=3306
RAE_DB_NAME=your-database
RAE_DB_USER=your-read-only-user
RAE_DB_PASSWORD=your-read-only-password

# Authentication database (csareport.users). Configure these in production.
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_NAME=csareport
AUTH_DB_USER=your-auth-database-user
AUTH_DB_PASSWORD=your-auth-database-password

# Use a long, random value in production and set AUTH_COOKIE_SECURE=1 behind HTTPS.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=0
