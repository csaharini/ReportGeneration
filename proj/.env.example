# Read-only MySQL connection used by /api/project-by-rae/{rae_id}
# Keep the real values in your hosting environment; do not commit a real .env file.
RAE_DB_HOST=your-db-host
RAE_DB_PORT=3306
RAE_DB_NAME=your-database
RAE_DB_USER=your-read-only-user
RAE_DB_PASSWORD=your-read-only-password

# Authentication database (csareport.users). Configure these in production.
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_NAME=csareport
AUTH_DB_USER=your-auth-database-user
AUTH_DB_PASSWORD=your-auth-database-password

# Standards library. These optional settings override AUTH_DB_*; omit them to
# use the same csareport database for standards and standard_clauses.
# STANDARDS_DB_HOST=127.0.0.1
# STANDARDS_DB_PORT=3306
# STANDARDS_DB_NAME=csareport
# STANDARDS_DB_USER=your-standards-database-user
# STANDARDS_DB_PASSWORD=your-standards-database-password

# Materials library. These optional settings override AUTH_DB_*; omit them to
# use the same csareport database for the materials table.
# MATERIALS_DB_HOST=127.0.0.1
# MATERIALS_DB_PORT=3306
# MATERIALS_DB_NAME=csareport
# MATERIALS_DB_USER=your-materials-database-user
# MATERIALS_DB_PASSWORD=your-materials-database-password

# Production safety: set APP_ENV=production, use a unique 32+ character random
# value, and serve the app over HTTPS. The app refuses insecure production
# session settings.
APP_ENV=development
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=0
